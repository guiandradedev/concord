# MySQL Configuration
MYSQL_ROOT_PASSWORD=your_secure_password_here
MYSQL_DATABASE=mydb
MYSQL_PORT=3306

# Kafka Configuration
KAFKA_BROKER_ID=1
KAFKA_PORT=9092
KAFKA_EXTERNAL_HOST=localhost
KAFKA_CLIENT_ID=realtime-gateway-client

# Application Configuration
JWT_SECRET=replace_with_a_long_random_secret
WEBSERVER_PORT=8082
REALTIME_GATEWAY_PORT=3000
FRONTEND_PORT=3001
NGINX_PORT=80

# Container Names
MYSQL_CONTAINER=discord-mysql
KAFKA_CONTAINER=discord-kafka
WEBSERVER_CONTAINER=discord-webserver
REALTIME_GATEWAY_CONTAINER=discord-realtime-gateway
FRONTEND_CONTAINER=discord-frontend
NGINX_CONTAINER=discord-nginx
