# MySQL Configuration
MYSQL_ROOT_PASSWORD=your_secure_password_here
MYSQL_DATABASE=mydb
MYSQL_PORT=3306
DB_USER=concord
DB_PASS=uma_senha_segura

# Kafka Configuration
KAFKA_BROKER_ID=1
KAFKA_CLUSTER_ID=replace_with_a_kraft_cluster_id
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_CLIENT_ID=realtime-gateway-client

# Application Configuration
JWT_SECRET=replace_with_a_long_random_secret
WEBSERVER_PORT=8082
REALTIME_GATEWAY_PORT=3000
FRONTEND_PORT=3001
NGINX_PORT=80

# Container Names
MYSQL_CONTAINER=concord-mysql
KAFKA_CONTAINER=concord-kafka
WEBSERVER_CONTAINER=concord-webserver
REALTIME_GATEWAY_CONTAINER=concord-realtime-gateway
FRONTEND_CONTAINER=concord-frontend
NGINX_CONTAINER=concord-nginx

# VirtualBox VMs directory
# Windows default: "C:\Users\<usuario>\VirtualBox VMs"
# Linux default: "/home/<usuario>/VirtualBox VMs"
# MacOS default: "/Users/<usuario>/VirtualBox VMs"
VBOX_VMS_DIR=""

# Repository
REPO_URL=https://github.com/guiandradedev/concord.git
BRANCH_NAME=development