# MongoDB Configuration
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=your_secure_password_here
MONGO_PORT=27017

# MySQL Configuration
MYSQL_ROOT_PASSWORD=your_secure_password_here
MYSQL_DATABASE=mydb
MYSQL_PORT=3306

# Kafka Configuration
KAFKA_BROKER_ID=1
KAFKA_PORT=9092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092

# Container Names
MONGODB_CONTAINER=discord-mongodb
MYSQL_CONTAINER=discord-mysql
KAFKA_CONTAINER=discord-kafka
