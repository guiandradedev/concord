    #     broker.vm.network "forwarded_port", guest:22, host: "2232"
    #     broker.vm.network "private_network", ip: "10.20.30.4", netmask: "255.255.255.240", virtualbox__intnet: "intnet1"

    #     # configs vbox
    #     broker.vm.provider "virtualbox" do |vb|
    #         vb.gui = !is_arm
    #         vb.memory = "1024"
    #         vb.cpus = 1
    #         vb.name = "broker"
    #     end

    #     # shell script
    #     broker.vm.provision "shell", inline: <<~SHELL
    #         sudo apt-get -y update

    #         apt-get install -y git
            
    #         mkdir -p /home/application
    #         cd /home/application
    #         if [ ! -d /home/application/concord ]; then
    #             git clone https://github.com/guiandradedev/concord.git
    #         fi

    #         apt-get install -y openjdk-21-jdk git

    #         curl -O https://dlcdn.apache.org/kafka/4.3.1/kafka_2.13-4.3.1.tgz
    #         tar -xzf kafka_2.13-4.3.1.tgz
    #         cd kafka_2.13-4.3.1

    #         KAFKA_CLUSTER_ID="$(bin/kafka-storage.sh random-uuid)"
    #         bin/kafka-storage.sh format --standalone -t $KAFKA_CLUSTER_ID -c config/server.properties
    #         bin/kafka-server-start.sh config/server.properties


    #         # TODO: adicionar carregamento apenas do executável ou pasta específica quando estiver de acordo
    #     SHELL
    # end

    # # VM 5: Gateway Realtime
    # config.vm.define "gateway" do |gateway|
    #     # configs gerais
    #     gateway.vm.box = BOX
    #     gateway.vm.hostname = "gateway"

    #     # interfaces de rede
    #     gateway.vm.network "forwarded_port", guest:22, host: "2233"
    #     gateway.vm.network "private_network", ip: "10.20.30.5", netmask: "255.255.255.240", virtualbox__intnet: "intnet1"

    #     # configs vbox
    #     gateway.vm.provider "virtualbox" do |vb|
    #         vb.gui = !is_arm
    #         vb.memory = "1024"
    #         vb.cpus = 1
    #         vb.name = "gateway"
    #     end

    #     # shell script
    #     gateway.vm.provision "shell", inline: <<~SHELL
    #         sudo apt-get -y update

    #         apt-get install -y git
            
    #         mkdir -p /home/application
    #         cd /home/application
    #         if [ ! -d /home/application/concord ]; then
    #             git clone https://github.com/guiandradedev/concord.git
    #         fi
    #         # TODO: adicionar carregamento apenas do executável ou pasta específica quando estiver de acordo
    #     SHELL
    # end

    # trigger para remover pasta residual da VM após destruí-la (evita conflito numa nova criação posterior)
    config.trigger.after :destroy do |trigger|
        trigger.ruby do |env, machine|
            vbox_vms_dir = ENV["VBOX_VMS_DIR"]

            if vbox_vms_dir.nil? || vbox_vms_dir.empty?
                env.ui.warn "VBOX_VMS_DIR não definida. Ignorando remoção da pasta da VM #{machine.name}..."
                next
            end

            vm_dir = File.join(vbox_vms_dir, machine.name.to_s)

            # polling enquanto vbox não liberou a pasta
            5.times do |attempt|
                break unless File.exist?(vm_dir)

                begin
                    FileUtils.rm_r(vm_dir)
                rescue SystemCallError
                    sleep 1
                end
            end

            if File.exist?(vm_dir)
                env.ui.warn "Não foi possível remover a pasta residual da VM #{machine.name}."
            end
        end
    end
    
end
