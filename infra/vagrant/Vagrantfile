Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"

  # nó do minikube
  config.vm.define "k8s" do |k8s|
    k8s.vm.hostname = "k8s"
    k8s.vm.network "private_network", ip: "192.168.56.2"
    k8s.vm.synced_folder "..", "/app"
    k8s.vm.provider "virtualbox" do |vb|
      vb.memory = 3096
      vb.cpus   = 2
    end
  end

  # bastion, que roda o Ansible contra o k8s
  config.vm.define "bastion", primary: true do |b|
    b.vm.hostname = "bastion"
    b.vm.network "private_network", ip: "192.168.56.3"
    b.vm.synced_folder "..", "/app"
    b.vm.provider "virtualbox" do |vb|
      vb.memory = 1024
      vb.cpus   = 1
    end

    b.vm.provision "shell", privileged: false, inline: <<-SHELL
      mkdir -p ~/.ssh
      cp /vagrant/.vagrant/machines/k8s/virtualbox/private_key ~/.ssh/k8s_key
      chmod 600 ~/.ssh/k8s_key
    SHELL

    b.vm.provision "ansible_local" do |ansible|
      ansible.playbook       = "/app/ansible/playbook.yaml"
      ansible.inventory_path = "/app/ansible/inventory.ini"
      ansible.limit          = "all"
    end
  end
end
# Depois adicionar mais configurações da VM e fazer o clone do repo. Por enquanto ta usando sync folder